generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum Role { ADMIN SALES WAREHOUSE ACCOUNTS }
enum CustomerStatus { LEAD ACTIVE INACTIVE }
enum CustomerType { RETAIL WHOLESALE DISTRIBUTOR }
enum MovementType { IN OUT }
enum ChallanStatus { DRAFT CONFIRMED CANCELLED }
model User { id String @id @default(cuid()); name String; email String @unique; passwordHash String; role Role @default(SALES); movements StockMovement[]; challans SalesChallan[]; createdAt DateTime @default(now()) }
model Customer { id String @id @default(cuid()); name String; businessName String?; email String? @unique; phone String; gstNumber String? @unique; type CustomerType @default(WHOLESALE); status CustomerStatus @default(LEAD); address String?; notes String?; followUpDate DateTime?; followUps FollowUp[]; challans SalesChallan[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Product { id String @id @default(cuid()); name String; sku String @unique; category String?; description String?; price Decimal @db.Decimal(12,2); currentStock Int @default(0); minimumStock Int @default(0); warehouse String?; imageUrl String?; movements StockMovement[]; items SalesChallanItem[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model StockMovement { id String @id @default(cuid()); productId String; product Product @relation(fields:[productId],references:[id]); type MovementType; quantity Int; reason String; createdById String; createdBy User @relation(fields:[createdById],references:[id]); createdAt DateTime @default(now()) }
model SalesChallan { id String @id @default(cuid()); challanNo String @unique; customerId String; customer Customer @relation(fields:[customerId],references:[id]); status ChallanStatus @default(DRAFT); createdById String; createdBy User @relation(fields:[createdById],references:[id]); items SalesChallanItem[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model SalesChallanItem { id String @id @default(cuid()); challanId String; challan SalesChallan @relation(fields:[challanId],references:[id],onDelete:Cascade); productId String; product Product @relation(fields:[productId],references:[id]); productName String; sku String; price Decimal @db.Decimal(12,2); quantity Int }
model FollowUp { id String @id @default(cuid()); customerId String; customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade); note String; dueDate DateTime; completedAt DateTime?; createdAt DateTime @default(now()) }
